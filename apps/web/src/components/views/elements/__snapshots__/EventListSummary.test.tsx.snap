// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`EventListSummary > correctly identifies transitions 1`] = `
<span
  class="mx_TextualEvent mx_GenericEventListSummary_summary"
>
  <span>
    <button
      class="mx_EventTile_spoiler"
      type="button"
    >
       
      <span
        class="mx_EventTile_spoiler_content"
      >
        user_1
      </span>
    </button>
     
    was invited, requested to join, was banned, joined, rejected their invitation, left, had their invitation withdrawn, was unbanned, was removed, left and was removed
  </span>
</span>
`;

exports[`EventListSummary > correctly orders sequences of transitions by the order of their first event 1`] = `
<span
  class="mx_TextualEvent mx_GenericEventListSummary_summary"
>
  <span>
    <span
      class="mx_AccessibleButton mx_InsideServiceName"
      data-user-id="@user_2:some.domain"
      role="button"
      tabindex="0"
    >
      user_2
    </span>
     
    was unbanned and joined and left 2 times
  </span>
  , 
  <span>
    <button
      class="mx_EventTile_spoiler"
      type="button"
    >
       
      <span
        class="mx_EventTile_spoiler_content"
      >
        user_1
      </span>
    </button>
     
    was unbanned, joined and left 2 times and was banned
  </span>
</span>
`;

exports[`EventListSummary > handles a summary length = 2, with 1 "other" 1`] = `
<span
  class="mx_TextualEvent mx_GenericEventListSummary_summary"
>
  <span>
    <span>
      <span
        class="mx_AccessibleButton mx_InsideServiceName"
        data-user-id="@user_1:some.domain"
        role="button"
        tabindex="0"
      >
        user_1
      </span>
      , 
      <span
        class="mx_AccessibleButton mx_InsideServiceName"
        data-user-id="@user_2:some.domain"
        role="button"
        tabindex="0"
      >
        user_2
      </span>
       and one other
    </span>
     
    joined
  </span>
</span>
`;

