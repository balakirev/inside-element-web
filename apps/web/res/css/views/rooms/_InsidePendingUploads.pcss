/* Files being sent: own bubbles at the end of the room timeline (InsidePendingUploads). */
.mx_InsidePendingUpload {
    display: flex;
    justify-content: flex-end;
    padding: 2px var(--cpd-space-4x) 2px 0;
    list-style: none;
}

.mx_InsidePendingUpload_bubble {
    max-width: min(100%, 70%);
    overflow: hidden;
    background-color: $eventbubble-self-bg;
    border-radius: 12px;
}

.mx_InsidePendingUpload_media {
    position: relative;
    max-width: 100%;
    background-color: var(--cpd-color-bg-subtle-primary);

    img,
    video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}

.mx_InsidePendingUpload_overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgb(0 0 0 / 40%);
}

.mx_InsidePendingUpload_ringWrap {
    position: relative;
    flex: none;
    width: 48px;
    height: 48px;
}

.mx_InsidePendingUpload_ring {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-width: 3px;
    stroke-linecap: round;
    /* Turns all the time, as in Telegram, so a slow start never looks frozen. */
    animation: mx_InsidePendingUpload_spin 2s linear infinite;

    @media (prefers-reduced-motion: reduce) {
        animation: none;
    }
}

@keyframes mx_InsidePendingUpload_spin {
    to {
        transform: rotate(360deg);
    }
}

.mx_InsidePendingUpload_ringTrack {
    stroke: rgb(255 255 255 / 25%);
}

.mx_InsidePendingUpload_ringValue {
    stroke: #fff;
    transition: stroke-dashoffset 0.2s linear;
}

.mx_InsidePendingUpload_cancel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    border-radius: 50%;

    svg {
        width: 20px;
        height: 20px;
    }
}

.mx_InsidePendingUpload_media .mx_InsidePendingUpload_progressText {
    position: absolute;
    top: var(--cpd-space-2x);
    inset-inline-start: var(--cpd-space-2x);
    padding: 1px var(--cpd-space-2x);
    font: var(--cpd-font-body-xs-regular);
    color: #fff;
    background-color: rgb(0 0 0 / 45%);
    border-radius: 10px;
}

.mx_InsidePendingUpload_file {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    min-width: 200px;
    padding: var(--cpd-space-2x) var(--cpd-space-3x);

    .mx_InsidePendingUpload_ringWrap {
        background-color: var(--cpd-color-icon-accent-primary);
        border-radius: 50%;
    }
}

.mx_InsidePendingUpload_fileIcon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 48px;
    height: 48px;
    color: var(--cpd-color-icon-on-solid-primary);
    background-color: var(--cpd-color-icon-critical-primary);
    border-radius: 50%;
}

.mx_InsidePendingUpload_fileInfo {
    display: flex;
    flex-direction: column;
    min-width: 0;

    .mx_InsidePendingUpload_progressText {
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }
}

.mx_InsidePendingUpload_fileName {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);
}

.mx_InsidePendingUpload_caption {
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-primary);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.mx_InsidePendingUpload_failedActions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    font: var(--cpd-font-body-sm-regular);
}

.mx_InsidePendingUpload_failedText {
    color: var(--cpd-color-text-critical-primary);
}
