/* The one-tap reactions float above the message context menu, as in other messengers. */
.mx_QuickReactionBar {
    position: absolute;
    bottom: 100%;
    inset-inline-start: 0;
    margin-bottom: var(--cpd-space-2x);
    list-style: none;

    > div {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-0-5x);
        padding: var(--cpd-space-1x) var(--cpd-space-1-5x);
        background-color: var(--cpd-color-bg-canvas-default);
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        border-radius: 999px;
        box-shadow: 0 6px 20px rgb(0 0 0 / 18%);
    }
}

.mx_QuickReactionBar_emoji,
.mx_QuickReactionBar_more {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: none;
    cursor: pointer;
}

.mx_QuickReactionBar_emoji {
    width: 40px;
    height: 40px;
    font-size: 28px;
    line-height: 1;
    transition: transform 0.1s ease-out;

    &:hover,
    &:focus-visible {
        transform: scale(1.18);
    }

    &.mx_QuickReactionBar_emoji_selected {
        background-color: var(--cpd-color-bg-subtle-primary);
    }

    &:disabled {
        cursor: default;
        opacity: 0.5;
    }
}

.mx_QuickReactionBar_more {
    width: 32px;
    height: 32px;
    margin-inline-start: var(--cpd-space-1x);
    color: var(--cpd-color-icon-secondary);
    background-color: var(--cpd-color-bg-subtle-secondary);

    svg {
        width: 20px;
        height: 20px;
    }
}
