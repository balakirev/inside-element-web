/* Inside: a person's name in a service message, as in Telegram (InsideServiceName.tsx). */
.mx_InsideServiceName {
    font-weight: 600;
    color: inherit;
    cursor: pointer;
    border-radius: 2px;

    &:hover,
    &:focus-visible {
        text-decoration: underline;
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: 1px;
    }
}
