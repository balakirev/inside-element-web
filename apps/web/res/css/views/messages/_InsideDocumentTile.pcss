/* Inside: a file in the chat as a Telegram-like document tile (InsideDocumentTile.tsx). */
.mx_MFileBody_inside_doc {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    max-width: 360px;
    min-width: 0;
}

.mx_MFileBody_inside_open {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: var(--cpd-space-3x);
    min-width: 0;
    cursor: pointer;
    border-radius: var(--cpd-space-3x);

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: 2px;
    }
}

.mx_MFileBody_inside_thumb {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    overflow: hidden;
    border-radius: 10px;
    background-color: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-icon-secondary);

    img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
    }
}

/* The first page of a document: paper white with a hairline. */
.mx_MFileBody_inside_thumb_picture {
    background-color: #fff;
    box-shadow: inset 0 0 0 1px var(--cpd-color-border-interactive-secondary);
}

.mx_MFileBody_inside_icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;

    svg {
        width: 28px;
        height: 28px;
    }
}

.mx_MFileBody_inside_iconLabel {
    font: var(--cpd-font-body-xs-semibold);
    letter-spacing: 0.02em;
}

.mx_MFileBody_inside_info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.mx_MFileBody_inside_name {
    display: flex;
    min-width: 0;
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);
}

.mx_MFileBody_inside_nameStart {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_MFileBody_inside_nameEnd {
    flex: none;
    white-space: pre;
}

.mx_MFileBody_inside_meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_MFileBody_inside_download {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--cpd-color-icon-secondary);

    svg {
        width: 20px;
        height: 20px;
    }

    &:hover {
        background-color: var(--cpd-color-bg-subtle-secondary);
        color: var(--cpd-color-icon-primary);
    }
}
