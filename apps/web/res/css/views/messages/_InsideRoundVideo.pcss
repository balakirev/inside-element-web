/* Inside: round video messages, as in Telegram (InsideRoundVideoBody.tsx, InsideRecordButton.tsx). */

/* ---- The tile: a pure circle, no bubble. ---------------------------------------------------- */

/* Skins draw bubbles on the line with long selectors; a round video has none, whatever they say. */
.mx_EventTile.mx_EventTile_inside_roundVideo {
    filter: none !important;

    > .mx_EventTile_line {
        width: fit-content !important;
        max-width: none !important;
        padding: 0 !important;
        border: none !important;
        border-radius: 50% !important;
        background: transparent !important;
        box-shadow: none !important;
        overflow: visible;
    }

    > .mx_EventTile_line .mx_EventTile_content,
    > .mx_EventTile_line .mx_EventTile_body {
        padding: 0 !important;
        background: transparent !important;
    }

    /* The sender of a group message: a small pill over the circle, not a bubble strip. */
    > [data-testid="event-tile-slot-sender"] {
        width: fit-content !important;
        max-width: 260px !important;
        margin-block-end: 4px;
        padding: 2px 10px !important;
        border-radius: 12px !important;
        background: var(--event-tile-bubble-other-background, var(--cpd-color-bg-canvas-default)) !important;
        box-shadow: none !important;
    }
}

.mx_InsideRoundVideoBody {
    position: relative;
    width: 260px;
    max-width: min(260px, 70vw);
    aspect-ratio: 1;
    border-radius: 50%;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: 3px;
    }
}

.mx_InsideRoundVideoBody_circle {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    background: var(--cpd-color-bg-subtle-secondary);
    /* Safari clips video to the radius only in its own layer. */
    isolation: isolate;
    transform: translateZ(0);
}

.mx_InsideRoundVideoBody_video,
.mx_InsideRoundVideoBody_poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}

/* The progress ring, on the edge of the circle. */
.mx_InsideRoundVideoBody_ring,
.mx_InsideRoundRecorder_ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    pointer-events: none;

    circle {
        fill: none;
        stroke: #fff;
        stroke-width: 2.4;
        stroke-linecap: round;
    }
}

.mx_InsideRoundVideoBody_ring circle {
    opacity: 0.9;
}

/* Paused with sound: a play mark in the middle. */
.mx_InsideRoundVideoBody_play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    border-radius: 50%;
    background: rgb(0 0 0 / 45%);

    &::after {
        content: "";
        position: absolute;
        inset-block-start: 15px;
        inset-inline-start: 19px;
        border-block: 9px solid transparent;
        border-inline-start: 14px solid #fff;
    }
}

/* Duration (remaining while playing), with the muted mark while it loops silently. */
.mx_InsideRoundVideoBody_duration {
    position: absolute;
    inset-block-end: 6px;
    inset-inline-start: 6px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    height: 20px;
    padding: 0 7px;
    border-radius: 10px;
    background: rgb(0 0 0 / 50%);
    color: #fff;
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
    line-height: 20px;
    pointer-events: none;
}

.mx_InsideRoundVideoBody_muted {
    width: 12px;
    height: 12px;
    color: inherit;
}

/* ---- The record button: mic and camera swap on a tap. --------------------------------------- */

.mx_MessageComposer_sendMessage.mx_InsideRecordButton {
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition: transform 0.15s ease-out;

    &.mx_InsideRecordButton_active {
        transform: scale(1.15);
    }
}

.mx_InsideRecordButton_icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
        opacity 0.18s ease-out,
        transform 0.22s cubic-bezier(0.3, 1.4, 0.6, 1);
    pointer-events: none;
}

.mx_InsideRecordButton_camera {
    opacity: 0;
    transform: scale(0.4) rotate(90deg);
}

.mx_InsideRecordButton_round {
    .mx_InsideRecordButton_mic {
        opacity: 0;
        transform: scale(0.4) rotate(-90deg);
    }

    .mx_InsideRecordButton_camera {
        opacity: 1;
        transform: none;
    }
}

/* Skins paint the button's icon as a mask (the mic); the camera is drawn as it is. */
.mx_MessageComposer_sendMessage.mx_InsideRecordButton .mx_InsideRecordButton_camera svg {
    width: 22px !important;
    height: 22px !important;
    background: none !important;
    -webkit-mask: none !important;
    mask: none !important;
    color: inherit;
    fill: currentColor;

    > * {
        display: inline !important;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_InsideRecordButton_icon,
    .mx_MessageComposer_sendMessage.mx_InsideRecordButton {
        transition: none;
    }
}

/* ---- While recording: the lock above the button, the camera circle over the chat. ----------- */

.mx_InsideRecordOverlay {
    position: fixed;
    inset: 0;
    z-index: 4000;
    pointer-events: none;
}

.mx_InsideRecordOverlay_hint {
    position: fixed;
    transform: translateX(-85%);
    padding: 6px 10px;
    border-radius: 8px;
    background: rgb(0 0 0 / 75%);
    color: #fff;
    font: var(--cpd-font-body-sm-regular);
    white-space: nowrap;
}

.mx_InsideRecordOverlay_lock {
    position: fixed;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    width: 36px;
    padding: 8px 0 6px;
    transform: translateX(-50%);
    border-radius: 18px;
    background: var(--cpd-color-bg-canvas-default);
    box-shadow: 0 1px 4px rgb(0 0 0 / 20%);
    color: var(--cpd-color-icon-secondary);

    svg {
        width: 18px;
        height: 18px;
    }

    svg + svg {
        animation: mx_InsideRecordOverlay_bob 1.2s ease-in-out infinite;
    }
}

@keyframes mx_InsideRecordOverlay_bob {
    50% {
        transform: translateY(-3px);
    }
}

.mx_InsideRoundRecorder {
    position: fixed;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transform: translateX(-50%);
    pointer-events: auto;
}

.mx_InsideRoundRecorder_circle {
    position: relative;
    width: min(280px, 50vh, 80vw);
    aspect-ratio: 1;
    border-radius: 50%;
}

.mx_InsideRoundRecorder_video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    background: #000;
    isolation: isolate;
    transform: translateZ(0);

    canvas {
        display: block;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 0.2s ease-out;
    }

    &.mx_InsideRoundRecorder_video_ready canvas {
        opacity: 1;
    }
}

.mx_InsideRoundRecorder_bar {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    padding: 0 12px;
    border-radius: 16px;
    background: var(--cpd-color-bg-canvas-default);
    box-shadow: 0 1px 4px rgb(0 0 0 / 15%);
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-md-regular);
}

.mx_InsideRoundRecorder_dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cpd-color-icon-critical-primary);
    animation: mx_InsideRoundRecorder_blink 1s steps(2, start) infinite;
}

@keyframes mx_InsideRoundRecorder_blink {
    to {
        visibility: hidden;
    }
}

.mx_InsideRoundRecorder_time {
    font-variant-numeric: tabular-nums;
}

.mx_InsideRoundRecorder_hint {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_InsideRoundRecorder_cancel {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--cpd-color-icon-critical-primary);

    &:hover {
        background: var(--cpd-color-bg-subtle-secondary);
    }

    svg {
        width: 20px;
        height: 20px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_InsideRoundRecorder_dot,
    .mx_InsideRecordOverlay_lock svg + svg {
        animation: none;
    }
}
