.mx_UploadConfirmDialog_fileIcon {
    margin-right: 5px;
}

.mx_UploadConfirmDialog_previewOuter {
    text-align: center;
}

.mx_UploadConfirmDialog_previewInner {
    display: inline-block;
    text-align: left;
    width: var(--MediaPreview-width);
    /* The preview width is fixed, but it must never overflow a narrow dialog. */
    max-width: 100%;
}

.mx_UploadConfirmDialog_imagePreview {
    max-height: 300px;
    max-width: 100%;
    border-radius: 4px;
    border: 1px solid $dialog-close-fg-color;
}

.mx_UploadConfirmDialog_caption {
    display: block;
    box-sizing: border-box;
    width: 100%;
    margin-top: var(--cpd-space-3x);
    padding: var(--cpd-space-2x) var(--cpd-space-4x);
    min-height: 42px;
    max-height: 160px;
    resize: none;
    field-sizing: content;
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-primary);
    background-color: var(--cpd-color-bg-subtle-secondary);
    border: 1px solid transparent;
    border-radius: 21px;
    outline: none;

    &:focus {
        border-color: var(--cpd-color-border-interactive-hovered);
    }

    &::placeholder {
        color: var(--cpd-color-text-secondary);
    }
}

/* The discard-caption question is shown over the dialog itself, not as a second dialog. */
.mx_UploadConfirmDialog_discard {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--cpd-space-4x);
    background-color: rgb(0 0 0 / 40%);
    border-radius: inherit;
    z-index: 1;
}

.mx_UploadConfirmDialog_discardCard {
    max-width: 340px;
    padding: var(--cpd-space-5x) var(--cpd-space-6x);
    text-align: center;
    background-color: var(--cpd-color-bg-canvas-default);
    border-radius: var(--cpd-space-4x);
    box-shadow: 0 8px 24px rgb(0 0 0 / 25%);

    h2 {
        margin: 0 0 var(--cpd-space-2x);
        font: var(--cpd-font-body-lg-semibold);
    }

    p {
        margin: 0 0 var(--cpd-space-4x);
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-secondary);
    }
}
